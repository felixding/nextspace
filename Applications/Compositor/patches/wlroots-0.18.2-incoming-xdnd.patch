+// SPDX-License-Identifier: MIT
+#include <assert.h>
+#include <stdlib.h>
+#include "util/time.h"
+#include <wlr/types/wlr_compositor.h>
+#include <wlr/types/wlr_data_device.h>
+#include <wlr/types/wlr_seat.h>
+#include <wlr/util/log.h>
+#include "types/wlr_data_device.h"
+#include "xwayland/selection.h"
+#include "xwayland/xwm.h"
+
+/* Keep one XDND selection bridge. Native offers use the existing wlroots drag
+ * and selection transfer machinery; the X source retains its pointer grab. */
+struct x11_drag {
+	struct wlr_data_source source;
+	struct wl_array atoms;
+	struct wlr_xwm *xwm;
+	struct wlr_drag *drag;
+	struct wlr_xwayland_surface *origin;
+	xcb_window_t owner, legacy_target;
+	const struct wlr_pointer_grab_interface *pointer;
+	struct wlr_pointer_grab_interface pointer_wrapper;
+	struct wlr_keyboard_grab_interface keyboard_wrapper;
+	struct wl_listener drag_destroy, origin_destroy, pending_destroy, legacy_destroy;
+	struct wlr_surface *pending_surface;
+	double pending_sx, pending_sy;
+	struct wl_event_source *timeout;
+	bool proxy_mapped, entered, released, dropped, finished, actions_known, source_destroyed;
+	uint32_t release_time;
+};
+
+static struct x11_drag *from_source(struct wlr_data_source *source) {
+	struct x11_drag *incoming = wl_container_of(source, incoming, source);
+	return incoming;
+}
+
+static void send_message_from(struct x11_drag *incoming, xcb_window_t target,
+		xcb_atom_t type, uint32_t flags, xcb_atom_t action) {
+	struct wlr_xwm *xwm = incoming->xwm;
+	xcb_client_message_data_t data = {0};
+	data.data32[0] = target;
+	data.data32[1] = flags;
+	data.data32[type == xwm->atoms[DND_STATUS] ? 4 : 2] = action;
+	xwm_dnd_send_event_to(xwm, incoming->owner, type, &data);
+}
+
+static void send_message(struct x11_drag *incoming, xcb_atom_t type,
+		uint32_t flags, xcb_atom_t action) {
+	send_message_from(incoming, incoming->xwm->dnd_selection.window, type, flags, action);
+}
+
+static void send_status(struct x11_drag *incoming) {
+	if (!incoming->entered || incoming->dropped) {
+		return;
+	}
+	struct wlr_data_source *source = &incoming->source;
+	bool accepted = incoming->drag && incoming->drag->focus &&
+		source->accepted && source->current_dnd_action;
+	/* Ask for every position: native widgets can accept different operations. */
+	send_message(incoming, incoming->xwm->atoms[DND_STATUS], 2 | accepted,
+		accepted ? xwm_dnd_action_to_atom(incoming->xwm, source->current_dnd_action) : XCB_ATOM_NONE);
+}
+
+static void sync_xwm(struct wlr_xwm *xwm) {
+	xcb_get_input_focus_reply_t *reply = xcb_get_input_focus_reply(xwm->xcb_conn,
+		xcb_get_input_focus(xwm->xcb_conn), NULL);
+	free(reply);
+}
+
+static void set_proxy(struct x11_drag *incoming, bool mapped) {
+	if (incoming->proxy_mapped == mapped) {
+		return;
+	}
+	wlr_log(WLR_DEBUG, "Incoming XDND proxy mapped=%d", mapped);
+	incoming->proxy_mapped = mapped;
+	struct wlr_xwm *xwm = incoming->xwm;
+	if (mapped) {
+		xcb_map_window(xwm->xcb_conn, xwm->dnd_selection.window);
+		xcb_configure_window(xwm->xcb_conn, xwm->dnd_selection.window,
+			XCB_CONFIG_WINDOW_STACK_MODE, (uint32_t[]){XCB_STACK_MODE_ABOVE});
+	} else {
+		xcb_unmap_window(xwm->xcb_conn, xwm->dnd_selection.window);
+		/* The source may coalesce leave/reentry before dispatching its next
+		 * motion. Its XDND enter state ends only on an actual XdndLeave. */
+	}
+	/* The next motion travels over Wayland, a different connection. Complete
+	 * the X map/unmap first so the source sees MapNotify before that motion. */
+	sync_xwm(xwm);
+}
+
+static void source_send(struct wlr_data_source *source, const char *mime, int fd) {
+	struct x11_drag *incoming = from_source(source);
+	xwm_selection_send_incoming(&incoming->xwm->dnd_selection,
+		&source->mime_types, &incoming->atoms, mime, fd);
+}
+
+static void source_accept(struct wlr_data_source *source, uint32_t serial,
+		const char *mime) {
+	send_status(from_source(source));
+}
+
+static void source_action(struct wlr_data_source *source,
+		enum wl_data_device_manager_dnd_action action) {
+	send_status(from_source(source));
+}
+
+static void destroy_incoming(struct x11_drag *incoming) {
+	set_proxy(incoming, false);
+	wl_list_remove(&incoming->origin_destroy.link);
+	wl_list_remove(&incoming->legacy_destroy.link);
+	wl_list_remove(&incoming->pending_destroy.link);
+	wl_event_source_remove(incoming->timeout);
+	incoming->xwm->incoming_drag = NULL;
+	struct wlr_xwm_selection_transfer *transfer, *tmp;
+	wl_list_for_each_safe(transfer, tmp, &incoming->xwm->dnd_selection.incoming, link) {
+		xwm_selection_transfer_destroy(transfer);
+	}
+	wl_array_release(&incoming->atoms);
+	free(incoming);
+}
+
+static void cancel_incoming(struct x11_drag *incoming) {
+	if (incoming->source_destroyed) destroy_incoming(incoming);
+	else wlr_data_source_destroy(&incoming->source);
+}
+
+static void source_destroy(struct wlr_data_source *source) {
+	struct x11_drag *incoming = from_source(source);
+	incoming->source_destroyed = true;
+	wlr_log(WLR_DEBUG, "Incoming XDND destroyed: released=%d dropped=%d finished=%d",
+		incoming->released, incoming->dropped, incoming->finished);
+	if (incoming->legacy_target && incoming->released && !incoming->finished) {
+		send_message_from(incoming, incoming->legacy_target, incoming->xwm->atoms[DND_STATUS], 2, XCB_ATOM_NONE);
+		send_message_from(incoming, incoming->legacy_target, incoming->xwm->atoms[DND_FINISHED], 0, XCB_ATOM_NONE);
+	}
+	if (incoming->dropped && !incoming->finished) {
+		/* Also clear the negotiated operation: GTK's X11 source reports its
+		 * last action even when XdndFinished carries failure. */
+		send_message(incoming, incoming->xwm->atoms[DND_STATUS], 2, XCB_ATOM_NONE);
+		send_message(incoming, incoming->xwm->atoms[DND_FINISHED], 0, XCB_ATOM_NONE);
+	}
+	if (!incoming->released && incoming->origin->surface &&
+			incoming->xwm->seat->pointer_state.focused_surface == incoming->origin->surface) {
+		/* End the legacy gesture with a rejected release. Some X toolkits do
+		 * not handle Escape, and a Wayland leave alone preserves their X grab.
+		 * Keep the physical seat button state until the real release arrives. */
+		send_message_from(incoming, incoming->legacy_target ? incoming->legacy_target :
+			incoming->xwm->dnd_selection.window, incoming->xwm->atoms[DND_STATUS], 2, XCB_ATOM_NONE);
+		sync_xwm(incoming->xwm);
+		wlr_seat_pointer_send_button(incoming->xwm->seat, get_current_time_msec(),
+			incoming->xwm->seat->pointer_state.grab_button, WL_POINTER_BUTTON_STATE_RELEASED);
+		wlr_seat_pointer_send_frame(incoming->xwm->seat);
+		wlr_seat_pointer_clear_focus(incoming->xwm->seat);
+	}
+	if (incoming->released && incoming->entered && !incoming->dropped &&
+			!incoming->finished && !incoming->legacy_target) {
+		/* The receiver may disappear before XdndDrop crosses the other
+		 * connection. Keep only the reply state until that message arrives;
+		 * XdndFinished sent before it can be ignored by the source. */
+		set_proxy(incoming, false);
+		wl_event_source_timer_update(incoming->timeout, 5000);
+		return;
+	}
+	destroy_incoming(incoming);
+}
+
+static void source_finish(struct wlr_data_source *source) {
+	struct x11_drag *incoming = from_source(source);
+	if (!incoming->dropped) {
+		wl_event_source_timer_update(incoming->timeout, 1);
+		return;
+	}
+	incoming->finished = true;
+	send_message(incoming, incoming->xwm->atoms[DND_FINISHED], 1,
+		xwm_dnd_action_to_atom(incoming->xwm, source->current_dnd_action));
+	/* Finish callers still own their offer until this callback returns. */
+	wl_event_source_timer_update(incoming->timeout, 1);
+}
+
+static const struct wlr_data_source_impl source_impl = {
+	.send = source_send,
+	.accept = source_accept,
+	.destroy = source_destroy,
+	.dnd_finish = source_finish,
+	.dnd_action = source_action,
+};
+
+static int timeout(void *data) {
+	struct x11_drag *incoming = data;
+	incoming->entered = false;
+	cancel_incoming(incoming);
+	return 0;
+}
+
+static struct x11_drag *from_grab(struct wlr_seat_pointer_grab *grab) {
+	struct wlr_drag *drag = grab->data;
+	return from_source(drag->source);
+}
+
+static void clear_pending(struct x11_drag *incoming) {
+	wl_list_remove(&incoming->pending_destroy.link);
+	wl_list_init(&incoming->pending_destroy.link);
+	incoming->pending_surface = NULL;
+}
+
+static void pointer_clear_focus(struct wlr_seat_pointer_grab *grab) {
+	struct x11_drag *incoming = from_grab(grab);
+	if (incoming->released) return;
+	clear_pending(incoming);
+	incoming->legacy_target = XCB_WINDOW_NONE;
+	wl_list_remove(&incoming->legacy_destroy.link);
+	wl_list_init(&incoming->legacy_destroy.link);
+	incoming->pointer->clear_focus(grab);
+	set_proxy(incoming, false);
+}
+
+static void pending_destroy(struct wl_listener *listener, void *data) {
+	struct x11_drag *incoming = wl_container_of(listener, incoming, pending_destroy);
+	/* A drop freezes its destination, but never keeps a dead surface. */
+	clear_pending(incoming);
+	incoming->pointer->clear_focus(&incoming->drag->pointer_grab);
+	if (!incoming->released) set_proxy(incoming, false);
+}
+
+static void legacy_destroy(struct wl_listener *listener, void *data) {
+	struct x11_drag *incoming = wl_container_of(listener, incoming, legacy_destroy);
+	wlr_data_source_destroy(&incoming->source);
+}
+
+static void pointer_enter(struct wlr_seat_pointer_grab *grab,
+		struct wlr_surface *surface, double sx, double sy) {
+	struct x11_drag *incoming = from_grab(grab);
+	if (incoming->released) return;
+	struct wlr_xwayland_surface *legacy = wlr_xwayland_surface_try_from_wlr_surface(surface);
+	if (legacy) {
+		pointer_clear_focus(grab);
+		incoming->legacy_target = legacy->window_id;
+		wl_signal_add(&legacy->events.destroy, &incoming->legacy_destroy);
+		return;
+	}
+	if (surface != incoming->pending_surface) {
+		wl_list_remove(&incoming->pending_destroy.link);
+		incoming->pending_surface = surface;
+		wl_signal_add(&surface->events.destroy, &incoming->pending_destroy);
+	}
+	incoming->pending_sx = sx; incoming->pending_sy = sy;
+	if (incoming->actions_known) {
+		incoming->pointer->enter(grab, surface, sx, sy);
+	}
+	set_proxy(incoming, true);
+}
+
+static uint32_t pointer_button(struct wlr_seat_pointer_grab *grab,
+		uint32_t time, uint32_t button, uint32_t state) {
+	struct x11_drag *incoming = from_grab(grab);
+	if (button == grab->seat->pointer_state.grab_button &&
+			state == WL_POINTER_BUTTON_STATE_RELEASED) {
+		incoming->released = true;
+		incoming->release_time = time;
+		wl_event_source_timer_update(incoming->timeout, incoming->legacy_target ? 10000 : 5000);
+	}
+	/* XdndDrop, rather than this physical release, commits a native drop. */
+	uint32_t serial = wlr_seat_pointer_send_button(grab->seat, time, button, state);
+	wlr_seat_pointer_send_frame(grab->seat);
+	return serial;
+}
+
+static void keyboard_key(struct wlr_seat_keyboard_grab *grab,
+		uint32_t time, uint32_t key, uint32_t state) {
+	wlr_seat_keyboard_send_key(grab->seat, time, key, state);
+}
+
+static void keyboard_modifiers(struct wlr_seat_keyboard_grab *grab,
+		const struct wlr_keyboard_modifiers *modifiers) {
+	wlr_seat_keyboard_send_modifiers(grab->seat, modifiers);
+}
+
+static void drag_destroy(struct wl_listener *listener, void *data) {
+	struct x11_drag *incoming = wl_container_of(listener, incoming, drag_destroy);
+	wl_list_remove(&incoming->drag_destroy.link);
+	incoming->drag = NULL;
+	clear_pending(incoming);
+	set_proxy(incoming, false);
+}
+
+static void origin_destroy(struct wl_listener *listener, void *data) {
+	struct x11_drag *incoming = wl_container_of(listener, incoming, origin_destroy);
+	incoming->released = true;
+	incoming->entered = false;
+	cancel_incoming(incoming);
+}
+
+void xwm_dnd_cancel_incoming(struct wlr_xwm *xwm) {
+	if (xwm->incoming_drag) {
+		/* X-to-X completion stays on X11; selection release acknowledges it. */
+		if (xwm->incoming_drag->legacy_target) xwm->incoming_drag->finished = true;
+		xwm->incoming_drag->released = true;
+		/* Selection loss ends any pending reply as well as the live source. */
+		xwm->incoming_drag->entered = false;
+		cancel_incoming(xwm->incoming_drag);
+	}
+}
+
+static void read_actions(struct x11_drag *incoming, uint32_t suggested) {
+	struct wlr_xwm *xwm = incoming->xwm;
+	incoming->source.actions = 0;
+	xcb_get_property_reply_t *reply = xcb_get_property_reply(xwm->xcb_conn,
+		xcb_get_property(xwm->xcb_conn, 0, incoming->owner,
+			xwm->atoms[DND_ACTION_LIST], XCB_ATOM_ATOM, 0, 64), NULL);
+	if (reply && reply->format == 32 && reply->type == XCB_ATOM_ATOM) {
+		xcb_atom_t *atoms = xcb_get_property_value(reply);
+		for (size_t i = 0; i < reply->value_len; i++) {
+			incoming->source.actions |= xwm_dnd_action_from_atom(xwm, atoms[i]);
+		}
+	}
+	free(reply);
+	if (!incoming->source.actions) {
+		incoming->source.actions = suggested ? suggested : WL_DATA_DEVICE_MANAGER_DND_ACTION_COPY;
+	}
+	incoming->actions_known = true;
+}
+
+void xwm_dnd_start_incoming(struct wlr_xwm *xwm) {
+	struct wlr_seat *seat = xwm->seat;
+	struct wlr_surface *surface = seat->pointer_state.focused_surface;
+	struct wlr_xwayland_surface *origin = surface ?
+		wlr_xwayland_surface_try_from_wlr_surface(surface) : NULL;
+	if (!origin || seat->drag || xwm->incoming_drag ||
+			seat->pointer_state.button_count != 1 ||
+			xwm->dnd_selection.owner == XCB_WINDOW_NONE ||
+			xwm->dnd_selection.owner == xwm->dnd_selection.window) {
+		return;
+	}
+	struct x11_drag *incoming = calloc(1, sizeof(*incoming));
+	if (!incoming) {
+		return;
+	}
+	incoming->xwm = xwm;
+	incoming->owner = xwm->dnd_selection.owner;
+	incoming->origin = origin;
+	wlr_data_source_init(&incoming->source, &source_impl);
+	wl_array_init(&incoming->atoms);
+	wl_list_init(&incoming->origin_destroy.link);
+	wl_list_init(&incoming->legacy_destroy.link);
+	incoming->legacy_destroy.notify = legacy_destroy;
+	wl_list_init(&incoming->pending_destroy.link);
+	incoming->pending_destroy.notify = pending_destroy;
+	incoming->timeout = wl_event_loop_add_timer(
+		wl_display_get_event_loop(seat->display), timeout, incoming);
+	if (!incoming->timeout || !xwm_selection_source_get_targets(&xwm->dnd_selection,
+			&incoming->source.mime_types, &incoming->atoms) || !incoming->atoms.size) {
+		if (incoming->timeout) {
+			wlr_data_source_destroy(&incoming->source);
+		} else {
+			free(incoming);
+		}
+		return;
+	}
+	incoming->source.actions = WL_DATA_DEVICE_MANAGER_DND_ACTION_COPY;
+	incoming->drag = wlr_drag_create(wlr_seat_client_for_wl_client(seat,
+		wl_resource_get_client(surface->resource)), &incoming->source, NULL);
+	if (!incoming->drag) {
+		wlr_data_source_destroy(&incoming->source);
+		return;
+	}
+	incoming->drag->keep_pointer_focus = true;
+	incoming->pointer = incoming->drag->pointer_grab.interface;
+	incoming->pointer_wrapper = *incoming->pointer;
+	incoming->pointer_wrapper.enter = pointer_enter;
+	incoming->pointer_wrapper.clear_focus = pointer_clear_focus;
+	incoming->pointer_wrapper.button = pointer_button;
+	incoming->drag->pointer_grab.interface = &incoming->pointer_wrapper;
+	incoming->keyboard_wrapper = *incoming->drag->keyboard_grab.interface;
+	incoming->keyboard_wrapper.key = keyboard_key;
+	incoming->keyboard_wrapper.modifiers = keyboard_modifiers;
+	incoming->drag->keyboard_grab.interface = &incoming->keyboard_wrapper;
+	incoming->drag_destroy.notify = drag_destroy;
+	wl_signal_add(&incoming->drag->events.destroy, &incoming->drag_destroy);
+	incoming->origin_destroy.notify = origin_destroy;
+	wl_signal_add(&origin->events.destroy, &incoming->origin_destroy);
+	xwm->incoming_drag = incoming;
+	double sx = seat->pointer_state.sx, sy = seat->pointer_state.sy;
+	wlr_seat_request_start_drag(seat, incoming->drag, surface, seat->pointer_state.grab_serial);
+	/* A compositor rejection destroys the source synchronously. */
+	if (xwm->incoming_drag == incoming) {
+		wlr_seat_pointer_enter(seat, surface, sx, sy);
+	}
+}
+
+void wlr_xwayland_drag_motion(struct wlr_xwayland *xwayland,
+		uint32_t time, double lx, double ly) {
+	struct wlr_xwm *xwm = xwayland->xwm;
+	struct x11_drag *incoming = xwm ? xwm->incoming_drag : NULL;
+	if (!incoming || !incoming->drag || incoming->released) {
+		return;
+	}
+	wlr_seat_pointer_send_motion(xwm->seat, time,
+		lx - incoming->origin->x, ly - incoming->origin->y);
+	wlr_seat_pointer_send_frame(xwm->seat);
+}
