+/* GTK 4.18 creates untyped override-redirect drag surfaces. During its grab,
+ * exclude only untyped auxiliary windows owned by the source process; typed
+ * menus and other clients remain eligible targets. No geometry heuristic. */
+bool wlr_xwayland_surface_is_drag_icon(struct wlr_xwayland_surface *surface) {
+	if (xwm_atoms_contains(surface->xwm, surface->window_type,
+			surface->window_type_len, NET_WM_WINDOW_TYPE_DND)) {
+		return true;
+	}
+	struct x11_drag *incoming = surface->xwm->incoming_drag;
+	return incoming && incoming->drag && surface != incoming->origin &&
+		surface->window_id != incoming->owner && surface->override_redirect &&
+		surface->window_type_len == 0 && surface->pid > 0 &&
+		surface->pid == incoming->origin->pid;
+}
