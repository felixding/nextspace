+int xwm_dnd_handle_incoming_message(struct wlr_xwm *xwm,
+		xcb_client_message_event_t *event) {
+	bool known = event->type == xwm->atoms[DND_ENTER] ||
+		event->type == xwm->atoms[DND_POSITION] ||
+		event->type == xwm->atoms[DND_LEAVE] || event->type == xwm->atoms[DND_DROP];
+	if (!known) {
+		return 0;
+	}
+	struct x11_drag *incoming = xwm->incoming_drag;
+	if (!incoming || event->format != 32 || event->window != xwm->dnd_selection.window ||
+			event->data.data32[0] != incoming->owner || incoming->dropped) {
+		return 1;
+	}
+	if (incoming->source_destroyed) {
+		if (event->type == xwm->atoms[DND_DROP]) {
+			send_message(incoming, xwm->atoms[DND_STATUS], 2, XCB_ATOM_NONE);
+			send_message(incoming, xwm->atoms[DND_FINISHED], 0, XCB_ATOM_NONE);
+			destroy_incoming(incoming);
+		} else if (event->type == xwm->atoms[DND_LEAVE]) {
+			destroy_incoming(incoming);
+		}
+		return 1;
+	}
+	wlr_log(WLR_DEBUG, "Incoming XDND message atom=%u entered=%d released=%d",
+		event->type, incoming->entered, incoming->released);
+	if (event->type == xwm->atoms[DND_ENTER]) {
+		unsigned version = event->data.data32[1] >> 24;
+		incoming->entered = version >= 3 && version <= XDND_VERSION;
+	} else if (event->type == xwm->atoms[DND_POSITION] && incoming->entered) {
+		xwm->dnd_selection.timestamp = event->data.data32[3];
+		incoming->source.compositor_action = xwm_dnd_action_from_atom(xwm, event->data.data32[4]);
+		if (!incoming->actions_known) {
+			read_actions(incoming, incoming->source.compositor_action);
+			/* Announce the immutable source action mask before creating offers. */
+			if (incoming->pending_surface) {
+				incoming->pointer->enter(&incoming->drag->pointer_grab,
+					incoming->pending_surface, incoming->pending_sx, incoming->pending_sy);
+			}
+		}
+		struct wlr_data_offer *offer;
+		wl_list_for_each(offer, &xwm->seat->drag_offers, link) {
+			if (offer->source == &incoming->source) {
+				data_offer_update_action(offer);
+			}
+		}
+		send_status(incoming);
+	} else if (event->type == xwm->atoms[DND_LEAVE]) {
+		incoming->entered = false;
+		if (incoming->released) {
+			wlr_data_source_destroy(&incoming->source);
+		}
+	} else if (event->type == xwm->atoms[DND_DROP] && incoming->entered && incoming->released) {
+		xwm->dnd_selection.timestamp = event->data.data32[2];
+		incoming->dropped = true;
+		wl_event_source_timer_update(incoming->timeout, 10000);
+		incoming->pointer->button(&incoming->drag->pointer_grab,
+			incoming->release_time, xwm->seat->pointer_state.grab_button, WL_POINTER_BUTTON_STATE_RELEASED);
+	}
+	return 1;
+}
