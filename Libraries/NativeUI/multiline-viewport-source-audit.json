{
  "date": "2026-11-06",
  "baseline": "39236619",
  "scope": "Pinned Chromium native textarea viewport integration; shared provider geometry foundation",
  "implementation": {
    "provider": "Ordinary NSTextView/NSScrollView; native clip frame, scroller-free client size and constrained min/max points. No new control implementation, layout, range-clamping or key table.",
    "transport": "Optional append-only API and owner-connection-only operation 34 payload; earlier by-value viewport and operations 32/33 unchanged.",
    "engine": "Exact textarea/owning layout identity. Native geometry feeds PaintLayerScrollableArea and PhysicalContractedBoxRect; original DOM rounding/zoom conversion remains in Blink. Native offsets use real SetScrollOffset/UpdateScrollOffset, retaining trusted scroll events. Native-to-engine offset transfer runs on the renderer work path, outside painting.",
    "paint": "Only the border-box theme call paints the complete native control. Guarded PaintInfo contents-background flag avoids a second document-sized native widget; native scroll updates invalidate the border-box display item.",
    "pointer": "Native NSScrollView supplies its own scroller and tracking. Blink scrollbar creation and overlapping corner resize grip/hit testing are disabled only for native-owned textareas. CSS/script enclosing-box resizing remains available. No replacement grip or scroller code.",
    "feature": "NEXTSPACE_CHROMIUM_MULTILINE_VIEWPORT=1 in addition to existing FORMS/INPUT/TEXT/MULTILINE flags, provider capabilities VIEWPORT and GEOMETRY, exact build-ID/instruction guards. Not the installed desktop default."
  },
