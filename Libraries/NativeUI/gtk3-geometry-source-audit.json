    }
  ],
  "runtime_audit": ".build/native-ui/browser-geometry-runtime-audit.json",
  "remaining_scope": [
    "Firefox dropdown groups, separators, hidden-selected labels, native intrinsic sizing and complete qualification.",
    "Browser derivatives, broader control/input/IME/accessibility/DPI coverage and installed deployment.",
    "GTK/Qt/KDE native control/menu/shortcut adapters using the same shared provider.",
    "Browser toolbar/tab/address-field replacement is skipped; it belongs to later explicitly requested app-specific patches."
  ],
  "findings": [
    "Read-only observers coexist with placement objects and do not register application policy metadata.",
    "GTK rejects non-toplevel geometry queries locally and reports unavailable on older compositors.",
    "The global Chromium accelerator boundary must be registered independently of optional native browser fields; native NSMenu then handles Alt+T even while the unchanged omnibox has focus, including after helper recovery.",
    "The stock browser UI is the default shared policy. Native control renderers and shortcut/menu algorithms are not duplicated in the adapters."
  ]
}
