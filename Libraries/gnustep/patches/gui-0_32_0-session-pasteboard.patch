 static	NSRecursiveLock		*dictionary_lock = nil;
 static	NSMapTable		*pasteboards = 0;
+/* Avoid reentering a mutating DO request from a nested GUI run loop. */
+static __thread unsigned pasteboardOperationDepth;
+BOOL GSPasteboardOperationInProgress(void) { return pasteboardOperationDepth != 0; }
+
+NSString * const GSPasteboardDidChangeNotification = @"GSPasteboardDidChangeNotification";
+
+NSString *GSPasteboardServerName(void)
+{
+  NSString *session = [[[NSProcessInfo processInfo] environment] objectForKey:@"NEXTSPACE_SESSION_ID"];
+  if ([session length] == 0) return PBSNAME;
+  NSCharacterSet *allowed = [NSCharacterSet characterSetWithCharactersInString:
+    @"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_"];
+  if ([session length] > 64 || [session rangeOfCharacterFromSet:[allowed invertedSet]].location != NSNotFound)
+    [NSException raise:NSInvalidArgumentException format:@"Invalid NEXTSPACE_SESSION_ID"];
+  return [PBSNAME stringByAppendingFormat:@"-%@", session];
+}
+
+NSString *GSSessionServiceName(NSString *name)
+{
+  NSString *storage = GSPasteboardServerName();
+  return [storage isEqual:PBSNAME] ? name : [storage stringByAppendingFormat:@"-service-%@", name];
+}
