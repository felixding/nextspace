 /*
  * Event Handling
  */
+/* Native command interpretation is shared by ordinary and embedded menus.
+ * The system input manager supplies bindings; menu commands only manipulate
+ * this view's existing cells, submenu presentations and target/actions. */
+- (void) keyDown: (NSEvent *)event
+{
+  NSMenuView *target = self;
+  _keyboardNavigation = YES;
+  while ([[target menu] attachedMenu] != nil)
+    target = [[[target menu] attachedMenu] menuRepresentation];
+  target->_keyboardNavigation = YES;
+  [target interpretKeyEvents: [NSArray arrayWithObject: event]];
+}
+
+- (void) _moveHighlight: (NSInteger)step from: (NSInteger)index
+{
+  NSInteger count = [_items_link count], remaining = count;
+  if (count == 0) return;
+  while (remaining-- > 0)
+    {
+      index = (index + step + count) % count;
+      NSMenuItem *item = [_items_link objectAtIndex: index];
+      if ([item isEnabled] && ![item isSeparatorItem])
+        {
+          [self detachSubmenu];
+          [self setHighlightedItemIndex: index];
+          return;
+        }
+    }
+  [self setHighlightedItemIndex: -1];
+}
+
+- (void) moveDown: (id)sender
+{
+  if (_horizontal) [self moveRight: sender];
+  else [self _moveHighlight: 1 from: _highlightedItemIndex];
+}
+
+- (void) moveUp: (id)sender
+{
+  if (_horizontal) [self moveLeft: sender];
+  else [self _moveHighlight: -1 from:
+    _highlightedItemIndex < 0 ? 0 : _highlightedItemIndex];
+}
+
+- (void) moveRight: (id)sender
+{
+  if (_horizontal)
+    [self _moveHighlight: 1 from: _highlightedItemIndex];
+  else if (_highlightedItemIndex >= 0)
+    {
+      NSMenuItem *item = [_items_link objectAtIndex: _highlightedItemIndex];
+      if ([item isEnabled] && [item submenu] != nil)
+        {
+          [self attachSubmenuForItemAtIndex: _highlightedItemIndex];
+          NSMenuView *view = [self attachedMenuView];
+          view->_keyboardNavigation = YES;
+          [view moveToBeginningOfDocument: sender];
+        }
+    }
+}
+
+- (void) moveLeft: (id)sender
+{
+  if (_horizontal)
+    [self _moveHighlight: -1 from:
+      _highlightedItemIndex < 0 ? 0 : _highlightedItemIndex];
+  else
+    {
+      NSMenu *parent = [_attachedMenu supermenu];
+      if ([parent attachedMenu] == _attachedMenu)
+        {
+          NSMenuView *view = [parent menuRepresentation];
+          view->_keyboardNavigation = YES;
+          [view detachSubmenu];
+        }
+      else [self cancelOperation: sender];
+    }
+}
+
+- (void) moveToBeginningOfDocument: (id)sender
+{ [self _moveHighlight: 1 from: -1]; }
+- (void) moveToEndOfDocument: (id)sender
+{ [self _moveHighlight: -1 from: 0]; }
+- (void) moveToBeginningOfLine: (id)sender
+{ [self moveToBeginningOfDocument: sender]; }
+- (void) moveToEndOfLine: (id)sender
+{ [self moveToEndOfDocument: sender]; }
+
+- (void) insertNewline: (id)sender
+{
+  if (_highlightedItemIndex < 0) return;
+  NSMenuItem *item = [_items_link objectAtIndex: _highlightedItemIndex];
+  if (![item isEnabled] || [item isSeparatorItem]) return;
+  if ([item submenu] != nil) [self moveRight: sender];
+  else
+    {
+      [self performActionWithHighlightingForItemAtIndex: _highlightedItemIndex];
+      [self cancelOperation: sender];
+    }
+}
+
+- (void) complete: (id)sender
+{ [self cancelOperation: sender]; }
+
+- (void) cancelOperation: (id)sender
+{
+  NSMenu *menu = _attachedMenu;
+  while ([menu isTransient] && [menu supermenu] != nil)
+    menu = [menu supermenu];
+  NSMenuView *view = [menu menuRepresentation];
+  [view detachSubmenu];
+  [view setHighlightedItemIndex: -1];
+  if ([menu isTransient]) [menu closeTransient];
+  /* End the existing mouse tracking loop without selecting its hover row. */
+  NSEvent *release = [NSEvent mouseEventWithType: NSLeftMouseUp
+    location: NSZeroPoint modifierFlags: 0
+    timestamp: [NSDate timeIntervalSinceReferenceDate]
+    windowNumber: [[menu window] windowNumber] context: nil
+    eventNumber: 0 clickCount: 1 pressure: 0];
+  [NSApp postEvent: release atStart: YES];
+}
