+  NSInteger index = [self _selectedFieldIndex];
+  NSCalendar *calendar = [self _pickerCalendar];
+  NSDate *date = [self dateValue];
+  NSDateComponents *step;
+  NSCalendarUnit unit;
+  NSDate *stepped;
+
+  if (index < 0 || (date == nil && !_allowsEmptyDate))
+    {
+      return NO;
+    }
+  if (date == nil)
+    {
+      [self setDateValue: [self _defaultDateForEditing]];
+      date = [self dateValue];
+      if (date == nil)
+        {
+          return NO;
+        }
+    }
