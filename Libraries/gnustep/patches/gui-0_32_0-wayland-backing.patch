+- (NSRect) convertRectToBacking: (NSRect)rect
+{
+  CGFloat scale = [self backingScaleFactor];
+  return NSMakeRect(rect.origin.x * scale, rect.origin.y * scale,
+                    rect.size.width * scale, rect.size.height * scale);
+}
+
+- (NSRect) convertRectFromBacking: (NSRect)rect
+{
+  CGFloat scale = [self backingScaleFactor];
+  return NSMakeRect(rect.origin.x / scale, rect.origin.y / scale,
+                    rect.size.width / scale, rect.size.height / scale);
+}
+
+- (void) _backendBackingScaleDidChange: (CGFloat)oldScale
+{
+  [self _processResizeEvent];
+  /* Allocated view gstates must bind the replacement backing surface. */
+  [_wv _invalidateCoordinates];
+  [_wv setNeedsDisplay: YES];
+  [self displayIfNeeded];
+  [self flushWindow];
+  [[NSNotificationCenter defaultCenter]
+    postNotificationName: NSWindowDidChangeBackingPropertiesNotification
+    object: self userInfo: [NSDictionary dictionaryWithObject:
+      [NSNumber numberWithDouble: oldScale] forKey: NSBackingPropertyOldScaleFactorKey]];
+}
+
+- (void) _backendSetMiniaturized: (BOOL)minimized
+{
+  if (minimized)
+    {
+      [self miniaturize: nil];
+    }
+  else if (_f.is_miniaturized)
+    {
+      if (_counterpart != 0)
+        {
+          NSWindow *mini = GSWindowWithNumber(_counterpart);
+          GSRemoveIcon(mini);
+          [mini orderOut: self];
+        }
+      /* The server already restored the retained surface and owns focus. */
+      [self _didDeminiaturize: nil];
+      [self displayIfNeeded];
+      [self flushWindow];
+    }
 }
 
