+/* The backend applies only compositor-confirmed fullscreen state. Keep the
+   ordinary style bits so leaving fullscreen restores the original decoration. */
+- (void) _backendSetFullscreen: (BOOL)fullscreen
+{
+  if (((_styleMask & NSFullScreenWindowMask) != 0) == fullscreen) return;
+  if (fullscreen) _styleMask |= NSFullScreenWindowMask;
+  else _styleMask &= ~NSFullScreenWindowMask;
+  [_wv _invalidateCoordinates];
+  [_wv layout];
+  NSRect frame = _frame;
+  frame.origin = NSZeroPoint;
+  [_wv setFrame: frame];
+  [_wv setNeedsDisplay: YES];
+}
+
+- (void) toggleFullScreen: (id)sender
+{
+  [GSServerForWindow(self) fullscreenwindow: _windowNum
+    : (_styleMask & NSFullScreenWindowMask) == 0];
 }
 
