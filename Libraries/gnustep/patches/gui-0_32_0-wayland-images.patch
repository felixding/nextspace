+#include <float.h>
+
+/* Backing density is separate from a window's logical device resolution. */
+static CGFloat GSImageBackingScale(NSGraphicsContext *context)
+{
+  id destination = [[context attributes] objectForKey:NSGraphicsContextDestinationAttributeName];
+  if ([context isDrawingToScreen] && [destination isKindOfClass:[NSWindow class]])
+    return [(NSWindow *)destination backingScaleFactor];
+  return 1.0;
+}
+
+/* TIFF resolutions pass through float precision before becoming point sizes. */
+static CGFloat GSImageRoundedPixels(CGFloat points, CGFloat resolution)
+{
+  CGFloat pixels = points * resolution / 72.0;
+  return floor(pixels + 0.5 + fabs(pixels) * FLT_EPSILON);
+}
