+/* Page fitting multiplies and divides coordinates. Ignore only roundoff at the
+ * final edge, or a fractional remainder can generate blank pages forever. */
+static BOOL GSPrintHasMore (CGFloat printed, CGFloat end)
+{
+  CGFloat epsilon = sizeof(CGFloat) == sizeof(float) ? FLT_EPSILON : DBL_EPSILON;
+  return end - printed > 4 * epsilon * MAX(1.0, MAX(fabs(printed), fabs(end)));
+}
+
+void GSPrintView (NSPrintOperation *operation, NSView *view, NSRect rect)
+{
+  NSGraphicsContext *context = [operation context];
+
+  NSRect sheet = NSMakeRect(0, 0, NSWidth(rect), NSHeight(rect));
+  [[[operation printInfo] dictionary] setObject: [NSValue valueWithRect: sheet]
+                                        forKey: @"NSPrintSheetBounds"];
+  [view beginDocument];
+  [view beginPageInRect: rect atPlacement: NSZeroPoint];
+
+  /* Printing the root view discards its window transform. Restore its flipped
+   * coordinates here, once for both export formats, without a screen scale.
+   * The exported rectangle starts at the origin of its own page. */
+  if ([view isFlipped])
+    {
+      DPStranslate(context, -NSMinX(rect), NSMaxY(rect));
+      DPSscale(context, 1, -1);
+    }
+  else
+    DPStranslate(context, -NSMinX(rect), -NSMinY(rect));
+  [view displayRectIgnoringOpacity: rect inContext: context];
+  [view endPage];
+  [view endDocument];
+}
