+/* Borrowed pending edits, valid only during events.commit_pending. Compositors
+ * can evaluate delayed commits against their own focus generation without
+ * replacing the protocol object's current state for a mismatched serial. */
+struct wlr_input_method_v2_commit_event {
+	struct wlr_input_method_v2 *input_method;
+	uint32_t serial;
+	const struct wlr_input_method_v2_state *state;
+};
+
 struct wlr_input_method_v2 {
 	struct wl_resource *resource;
 
@@ -56,6 +65,7 @@
 		struct wl_signal new_popup_surface; // struct wlr_input_popup_surface_v2
 		struct wl_signal grab_keyboard; // struct wlr_input_method_keyboard_grab_v2
 		struct wl_signal destroy; // struct wlr_input_method_v2
+		struct wl_signal commit_pending; // struct wlr_input_method_v2_commit_event
 	} events;
 };
 
--- a/types/wlr_input_method_v2.c
+++ b/types/wlr_input_method_v2.c
@@ -81,6 +81,12 @@
 	if (!input_method) {
