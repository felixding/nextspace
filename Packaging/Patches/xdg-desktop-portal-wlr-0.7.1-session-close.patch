+
+/* Notify the frontend before transport shutdown removes active producers. */
+void xdpw_session_notify_closed(struct xdpw_state *state) {
+	struct xdpw_session *session;
+	wl_list_for_each(session, &state->xdpw_sessions, link) {
+		sd_bus_emit_signal(state->bus, session->session_handle,
+			interface_name, "Closed", "");
+	}
+	sd_bus_flush(state->bus);
+}
