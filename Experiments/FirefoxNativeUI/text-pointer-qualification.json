  "status": "Partial native mouse text selection on one pinned Firefox ESR binary; complete native browser/non-GNUstep application integration remains unfinished.",
  "implementation": {
    "native_controls": "Existing unchanged NSTextField/NSSecureTextField field editors and their actual mouseDown tracking",
    "hit_testing": "Actual native character hit testing, shift extension, selection ranges and selected pixels; no selection geometry or tracking algorithm copied",
    "engine_boundary": "Guarded nsIFrame::HandleEvent suppresses engine selection defaults only for prepared native fields; original EventStateManager retains DOM events, focus handlers, capture cleanup and click dispatch",
    "capture": "Actual Gecko GetNearestScrollContainerFrame, SetCapturingContent and StopTrackingDragGesture; native editor supplies selection",
    "busy_snapshot": "Text operation-5 query returns native pixels without applying configuration or model during tracking",
    "canonical_model": "Changed value/editability, focus or dimensions terminate native tracking before rebinding; native selection echo checks the canonical engine value",
    "invalidation": "Existing process-owned eventfd and GLib UI-loop subscription; no pointer or caret timer added",
    "compiled": "Optional Gecko adapter and compatibility test stubs; main NativeUI provider/loader/shim, AppKit and Firefox reused unchanged"
  },
