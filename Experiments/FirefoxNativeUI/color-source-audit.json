  "native_ui": "existing shared NSColorWell/NSColorPanel only",
  "browser_rebuilt": false,
  "picker_activation_boundary": "Original InitColorPicker validates and consumes user activation before the proxy refreshes the native model and obtains the original color-owner token. Native drawing must not precede that permission check.",
  "callback_completion": "The original XPCOM Update/Done callback is retained and forwarded. The shared native panel stays visible after its close request until original Done returns and its source process acknowledges the exact original session token. Reentrant new sessions reject stale completion. No queued input, shortcut override or duplicated picker is introduced.",
  "native_notification_priority": {
    "lifecycle_and_actions": 0,
    "repaint": 200,
    "finding": "Lifecycle completion and native action receipts are serviced at ordinary GTK/Gecko event priority. Dirty-control repaint requests are merged separately and dispatched at idle priority; progress painting cannot gate a picker callback."
  },
  "bootstrap_negotiation": "A missing constructor capability reply is retried at the existing libxul bootstrap boundary before feature bindings are committed. A real lost-first-reply regression verifies colour, text, address and menu-key bindings in the actual parent; no browser rebuild or duplicate native control.",
  "presentation_reply": "Both adapters use the completed native presentation reply as their state/action baseline. An unavailable follow-up status read no longer rejects an already opened panel. The real-provider transaction regression reproduces the old failure and verifies retention plus explicit close with the current shared header.",
  "running_picker_reveal": "Shared operation59/state2 reveals an already-active original NSColorWell panel. It preserves its browser callback, close ticket and borrowed references; inactive controls cannot create a session through reveal.",
  "native_stack_reentrancy": "The shared host defers another connection's presentation and key input through its existing bounded queue until the current native stack returns. The callback owner keeps original immediate refusal; the UI-library action/key guards remain unchanged.18 real-provider cases verify one button action and retained original picker ownership.",
  "atomic_color_snapshot": {
    "implementation": "Libraries/NativeUI/Bridge/ColorBinding.inc and Specialized.inc",
    "finding": "Separate status/model reads could consume a newer native colour with an older action cursor and permanently drop the application update. One existing typed-model reply already carries both values atomically.",
    "regression": "Tests/NativeUI/color-snapshot-probe.c: old binding fails the deterministic response-boundary action; new binding passes nine cases",
    "qualified": true,
    "evidence": [
      ".build/native-ui/reported-issues/ux-regressions/ordinary-131-scale-1/ordinary-picker-ux.json",
      ".build/native-ui/reported-issues/ux-regressions/ordinary-131-scale-2/ordinary-picker-ux.json",
      ".build/native-ui/reported-issues/ux-regressions/native-api-110/results.json"
    ]
  },
  "native_color_key_lifetime": {
    "implementation": "Libraries/NativeUI/GNUstep/Specialized.inc",
    "finding": "The component host does not run NSApplication; NSWindow close skips key resignation in that state. Resign the existing original NSColorPanel before acknowledged close, as the immediate-close path already does.",
    "regression": "Tests/NativeUI/color-lifetime-probe.m fails on the previous provider and passes with the original resignKeyWindow call.",
    "qualified": true,
    "evidence": [
      ".build/native-ui/reported-issues/ux-regressions/ordinary-131-scale-1/ordinary-picker-ux.json",
      ".build/native-ui/reported-issues/ux-regressions/ordinary-131-scale-2/ordinary-picker-ux.json",
      ".build/native-ui/reported-issues/ux-regressions/native-api-110/results.json"
    ]
  },
  "gtk_activation_focus_snapshot": {
