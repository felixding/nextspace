    "source": "Libraries/NativeUI/Bridge/Gtk3Geometry.c",
    "change": "Synchronize original GDK display protocol state before its launch context selects the input serial and focused source. Recheck the existing generation after synchronization.",
    "regression": "Tests/NativeUI/check-gtk-activation-focus.py",
    "negative_control": "The active original GNUstep well remains active while its panel becomes hidden after a token with no focused source.",
    "controls_duplicated": false,
    "browser_rebuilt": false,
    "evidence": [
