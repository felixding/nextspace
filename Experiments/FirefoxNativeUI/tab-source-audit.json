  "library_build_id": "ace600697490ec169e3e371fb456dcb542e3abef",
  "guards": "Existing initializer verifies libxul build ID. pinned-tabs.h verifies 20 compiled bytes at the flex display entry and every new DOM/model/lifetime/activation call before activation. Existing frame, background, event and process-role guards remain in force. Optional shared tab capability is required before installation.",
  "interfaces": {
    "owner": "Live parent-process predicate, actual nsXULElement vtable at base+0xa0c34f8+16, native id attribute tabbrowser-tabs.",
    "model": "Element::GetElementsByTagName, actual ContentList accessors and Element::GetAttr(label/selected).",
    "lifetime": "Retain tab DOM nodes while represented; release old models on retirement and native frame destruction. Retain exact binding identity across original input dispatch.",
    "rendering": "Existing nsDisplayThemedBackground fallback and DrawTarget bitmap transport; original flex children retain their model but do not duplicate native painting.",
    "activation": "Committed native selection invokes original nsXULElement::ClickWithInputSource after uncancelled trusted physical input.",
    "invalidation": "Original GLib idle queue invalidates the complete owner after model/selection/title/size changes and the display-list transaction commits."
  },
  "separation": {
    "actual_NSTabView": true,
    "shared_client_serializer": "Libraries/NativeUI/Bridge/Tabs.inc",
    "no_copied_control_layout_drawing_hit_testing_or_keys": true,
    "no_CSS_theme": true,
    "provider_appkit_browser_binaries_unchanged": true,
    "application_menu_visibility_policy_unchanged": true
  },
  "findings": [
    "Firefox tabs are custom XUL browser elements, not GTK notebook controls. Use its actual DOM and activation APIs.",
    "Native model logs did not prove visible correctness: initial complete pixels passed while additional tab labels remained stale. Deferred whole-owner invalidation fixes the retained native background image.",
    "Gecko activation already dispatches down/up/click and invokes browser handlers; no duplicated gBrowser selection implementation is needed.",
    "DOM node ownership prevents pointer reuse from reusing opaque IDs. Original dispatch can recreate frames; preserve the exact control identity rather than a borrowed frame address.",
    "The first actual Workspace run reached host-replaced native pixels but the test left Marionette in chrome context. The tab test wrapper now restores content context before subsequent navigation.",
    "The shared provider still has its separately qualified 1x/2x native behavior; only scale-1 Firefox embedding is qualified here."
  ],
