  "base_commit": "db0f0031",
  "status": "Partial native mouse selection for themed plain/password webpage fields in one exact unchanged Chromium ARM64 build. Complete native browsers, derivatives, address bars/frontends and GTK/Qt/KDE applications remain unfinished.",
  "implementation": {
    "native_controls": "Existing unchanged NSTextField/NSSecureTextField editors; no copied glyph hit testing, selection tracking, widgets, key bindings or caret timers",
    "engine_boundary": "Native selection begins at the real SelectionController press default after cancellable DOM events and focus. The actual mouse manager keeps lifecycle bookkeeping; its drag default bypasses competing engine selection/data dragging/autoscroll during the claimed gesture.",
    "release": "Native release settles actual tracking; the outer EventHandler release clears ownership even when mouseup is cancelled.",
    "canonical_model": "Changes to canonical engine value/range, read-only/disabled state, focus or field dimensions terminate native tracking before rebinding. Native selection echo cannot overwrite script changes.",
    "busy_editor": "Existing operation 5 returns actual busy editor pixels without a configuration/model mutation.",
    "notifications": "Existing process-owned eventfd and renderer work-loop callback; no pointer timer.",
    "compiled": "Optional Chromium C adapter only. Browser, AppKit and shared provider/loader/shim reused unchanged."
  },
